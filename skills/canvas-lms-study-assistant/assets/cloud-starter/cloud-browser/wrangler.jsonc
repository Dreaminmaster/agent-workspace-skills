{
  "name": "canvas-browser",
  "main": "service.mjs",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OWNER_STATE",
        "class_name": "OwnerState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OwnerState"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "SESSION_TTL_HOURS": "24",
    "CANVAS_USER_ID": "REPLACE_WITH_YOUR_CANVAS_USER_ID"
  }
}
